/* Generated by wallust from the wallpaper. Do NOT edit by hand. */
* {
    bg:       {{background}}ee;
    bg-alt:   {{background}}f5;
    surface:  {{color0}};

    fg:       {{foreground}};
    fg-dim:   {{color7}};
    fg-muted: {{color8}};

    blue:     {{color4}};
    cyan:     {{color6}};
    purple:   {{color5}};
    green:    {{color2}};
    red:      {{color1}};
}
