# Generated by wallust from the wallpaper. Do NOT edit by hand.
[global]
    monitor = 0
    follow = mouse
    width = 340
    height = 140
    origin = top-right
    offset = 14x48
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    separator_color = frame
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    corner_radius = 8
    icon_position = left
    max_icon_size = 48
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "{{background}}"
    foreground = "{{foreground}}"
    frame_color = "{{color8}}"
    timeout = 6

[urgency_normal]
    background = "{{background}}"
    foreground = "{{foreground}}"
    frame_color = "{{color4}}"
    timeout = 8

[urgency_critical]
    background = "{{background}}"
    foreground = "{{foreground}}"
    frame_color = "{{color1}}"
    timeout = 0
