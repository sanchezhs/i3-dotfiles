[Trigger]
Operation=Install
Operation=Upgrade
Operation=Remove
Type=Package
Target=nvidia-open-dkms
Target=nvidia-open
Target=nvidia
Target=nvidia-lts
Target=nvidia-dkms

[Action]
Description=Regenerating initramfs after NVIDIA change...
Depends=mkinitcpio
When=PostTransaction
Exec=/usr/bin/mkinitcpio -P
